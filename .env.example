# Скопируйте в .env и при необходимости поменяйте значения
POSTGRES_DB=skillswap
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=skillswap

JWT_SECRET=change-me-to-a-long-random-secret-string

# Администратор создаётся автоматически при первом запуске
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@skillswap.dev
ADMIN_PASSWORD=admin12345

START_CREDITS=3
# Демо-пользователи anna / ivan (пароль demo123) и несколько навыков
SEED_DEMO=true

APP_PORT=8080
